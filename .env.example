# ============================================================
# WebIDE-Tbale 环境变量示例
# 复制为 .env 后按需填写（.env 已被 .gitignore 排除，不会入库）
# 未设置的项一律使用代码或 config/ai_config.json 中的默认值
# ============================================================

# ==================== 访问令牌 ====================
# 留空则后端启动时自动生成，并写入 backend/.webide_token
# 前端开发服务器会自动读取该文件并在代理层注入，浏览器端不持有令牌
WEBIDE_AUTH_TOKEN=

# ==================== 服务绑定 ====================
# 默认仅监听本机回环。本服务可执行代码与系统命令，跨机暴露前请确认网络可信
WEBIDE_HOST=127.0.0.1
WEBIDE_PORT=5000

# ==================== AI（可选覆盖）====================
# 注意：AI 配置的统一入口是 config/ai_config.json
#      日常维护（换密钥 / 换模型）请改该文件，或改 config/ai_config.local.json
#      本处环境变量优先级最高，仅用于 CI / 容器等不便挂载文件的场景
DASHSCOPE_API_KEY=
WEBIDE_AI_MODEL=
WEBIDE_AI_BASE_URL=
WEBIDE_AI_MAX_MESSAGES=
WEBIDE_AI_TIMEOUT=

# ==================== 上传限制 ====================
# 单个上传文件体积上限（MB）
WEBIDE_MAX_UPLOAD_MB=50

# ==================== 执行限制（/run 与 /terminal/execute）====================
# 执行超时（秒），超时将终止整棵进程树
WEBIDE_EXEC_TIMEOUT=30
# 单个子进程内存上限（MB），Windows 通过 Job Object 施加
WEBIDE_EXEC_MEMORY_MB=1024
# 并发子进程数上限，防止 fork 炸弹
WEBIDE_EXEC_MAX_PROCS=32
# 输出截断阈值（KB）
WEBIDE_EXEC_MAX_OUTPUT_KB=200
# 单次提交代码体积上限（KB）
WEBIDE_EXEC_MAX_CODE_KB=100
# 是否以隔离模式（python -I）运行代码：1 开启 / 0 关闭
WEBIDE_EXEC_ISOLATED=1

# ==================== 终端命令策略 ====================
# 关闭白名单与元字符过滤（危险，仅在本机完全可信时使用）
WEBIDE_TERMINAL_UNRESTRICTED=0
# 追加到默认白名单的命令，逗号分隔
WEBIDE_TERMINAL_ALLOWLIST=
